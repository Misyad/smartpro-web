# Env files. .env.example is the only one that belongs in git; everything else
# holds credentials. This repo targets a live Supabase project whose
# service-role key bypasses RLS, so a committed .env is a full compromise.
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Local clone of the antislop rulebook (skills are vendored in .opencode/skills)
anti-slop/

# Jenkins helper script written at build time
.ci-lint-test.sh

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
