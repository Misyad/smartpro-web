# SMartPro - environment variables
#
# Copy to .env and fill in. Never commit .env itself.
#
# --- Supabase Cloud -------------------------------------------------------
# Project settings -> API. SUPABASE_URL looks like https://<ref>.supabase.co
SUPABASE_URL=
# Safe to expose to the browser, but this app only reads it server-side.
SUPABASE_ANON_KEY=
# BYPASSES ROW LEVEL SECURITY. Server only. Never prefix with VITE_ or PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paymenku -------------------------------------------------------------
# From the Paymenku dashboard. Same account as telegram-store-bot-mvp.
PAYMENKU_API_KEY=
# Optional override. Defaults to the value below when unset.
PAYMENKU_BASE_URL=https://paymenku.com/api/v1
# Verifies the X-PaymenKu-Signature header on the webhook. Must match the
# secret configured in the Paymenku dashboard.
PAYMENKU_WEBHOOK_SECRET=

# --- App ------------------------------------------------------------------
# Public origin, used for Paymenku return_url and webhook callbacks.
APP_URL=https://smartpro-web.projecthasan.com
